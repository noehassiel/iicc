{
    "name": "noehassiel/preview-bridge",
    "description": "Lets a Laravel site be reviewed inside the noehassiel client portal: allows framing and reports the page the client is on.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "noehassiel",
            "homepage": "https://noehassiel.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0|^5.0",
        "pestphp/pest-plugin-laravel": "^4.0|^5.0"
    },
    "autoload": {
        "psr-4": {
            "Noehassiel\\PreviewBridge\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Noehassiel\\PreviewBridge\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Noehassiel\\PreviewBridge\\PreviewBridgeServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
